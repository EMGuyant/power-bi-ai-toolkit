model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["DevMode","DaxQueryView_Desktop","Copilot","CopilotMeasureDescriptions","DaxCopilot_Change_Accepted_In_Desktop","TMDLView_Desktop"]

annotation PBI_QueryOrder = ["Employee","Products","Regions","Sales"]

ref table Employee
ref table Products
ref table Regions
ref table Sales
ref table _Measures

ref cultureInfo en-US

