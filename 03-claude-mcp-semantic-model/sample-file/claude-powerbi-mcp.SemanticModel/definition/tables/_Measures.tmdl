table _Measures
	lineageTag: b6909707-4085-4814-802c-30cef14b9bdf

	measure 'Sales Metric (CY)' = ```
			
			VAR _currentYear = YEAR(MAX(Sales[SalesDate]))
			RETURN
			CALCULATE([Total Sales], DateTable[Year]=_currentYear)
			    
			```
		displayFolder: Sales\Current Year
		lineageTag: 506e94a7-eb0c-4a8c-b578-43309ee4c61b

		formatStringDefinition = "\$#,0.00;(\$#,0.00);\$#,0.00"

	measure 'Sales Metric (LY)' = ```
			VAR _lastYear = YEAR(MAX(Sales[SalesDate]))-1
			VAR _currentYear = YEAR([Current Date])
			VAR _endOfCurrentMonth = EOMONTH([Current Date], 0)
			VAR _selectedYearCat = SELECTEDVALUE(DateTable[Year Category])
			
			RETURN
			SWITCH(
			    TRUE(),
			    _selectedYearCat = "This Year",
			        CALCULATE([Total Sales], SAMEPERIODLASTYEAR(DATESBETWEEN(DateTable[Date], DATE(_currentYear, 1, 1), _endOfCurrentMonth))),
			    _selectedYearCat <> "This Year",
			        CALCULATE([Total Sales], ALL(DateTable), DateTable[Year]=_lastYear)
			)
			    
			```
		displayFolder: Sales\Last Year
		lineageTag: 07ff4f4a-69c5-4fac-955a-caff07c731d5

		formatStringDefinition = "\$#,0.00;(\$#,0.00);\$#,0.00"

	measure 'Sales Metric YOY' = ```
			
			VAR _cy = [Sales Metric (CY)]
			VAR _ly = [Sales Metric (LY)]
			
			RETURN
			IF(
			    ISBLANK(_cy) || ISBLANK(_ly),
			    BLANK(),
			    DIVIDE(_cy-_ly, _ly)
			)
			    
			```
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Sales\YoY
		lineageTag: 8cf15419-276c-4fa8-b685-a07230778bbd

